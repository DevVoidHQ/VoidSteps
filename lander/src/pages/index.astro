---
import BaseLayout from "../layouts/BaseLayout.astro";
import PillNav from "../components/landing/PillNav";
import HeroSection from "../components/landing/HeroSection";
import ShowcaseSection from "../components/landing/ShowcaseSection";
import StepsSection from "../components/landing/StepsSection";
import PrivacyBand from "../components/landing/PrivacyBand";
import CloseSection from "../components/landing/CloseSection";
---

<BaseLayout>
  <div class="min-h-screen bg-background text-foreground">
    <PillNav />
    <main>
      <HeroSection client:load />
      <ShowcaseSection client:visible />
      <StepsSection client:visible />
      <PrivacyBand client:visible />
      <CloseSection client:visible />
    </main>
  </div>
</BaseLayout>
