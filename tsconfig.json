{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "node" is for test files that read the repo (see focus-tracks.test.ts,
    // which enforces that every shipped asset is credited). App code must not
    // import node builtins; the app runs in a webview.
    "types": ["vite/client", "vitest/globals", "node"],
    "skipLibCheck": true,
    "jsx": "react-jsx",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,

    /* Path aliases (baseUrl omitted: deprecated in TS 6+; under bundler
       moduleResolution, paths resolve relative to this tsconfig) */
    "paths": {
      "@/*": ["./app/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["app"]
}
